{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "router/index.ts",
    "router/scripts/**/*.ts",
    "router/src/**/*.ts",
    "router/test/**/*.ts",
    "pipeline/src/**/*.ts",
    "pipeline/test/**/*.ts"
  ]
}
